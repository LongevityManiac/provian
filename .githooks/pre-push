#!/bin/sh
# Refuses a push that would land a GitHub Actions workflow able to burn Actions
# minutes unattended: a job without timeout-minutes, or a push trigger.
# There is no per-push CI, so this hook IS the enforcement point before a change
# lands on the remote; `npm run check:wp2` (the pre-push battery) and the nightly
# typecheck (root) leg run the same check as backstops.
# See scripts/check-workflow-budget.mjs. Enabled by: git config core.hooksPath .githooks
#
# stdin: "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref.

ROOT=$(git rev-parse --show-toplevel) || exit 1
ZERO=0000000000000000000000000000000000000000
STATUS=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  # A ref deletion lands no tree.
  [ "$LOCAL_SHA" = "$ZERO" ] && continue
  node "$ROOT/scripts/check-sdk-typecheck.mjs" --rev "$LOCAL_SHA" || STATUS=1
  node "$ROOT/scripts/check-workflow-budget.mjs" --rev "$LOCAL_SHA" || STATUS=1
  node "$ROOT/scripts/check-repo-boundary.mjs" --rev "$LOCAL_SHA" || STATUS=1
  node "$ROOT/scripts/check-reader-facing-ids.mjs" --rev "$LOCAL_SHA" || STATUS=1
done
exit $STATUS
