{
  "name": "provian",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@11.6.0",
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "overrides": {
    "elliptic": "6.6.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "launch-smoke": "node scripts/launch-smoke/launch-smoke.mjs",
    "verify-launch-indexes": "node provian-backend/scripts/verify-launch-indexes.mjs",
    "launch-smoke-control": "node scripts/launch-smoke/gate-control.mjs",
    "x402-live-verify": "node scripts/launch-smoke/x402-live-verify.mjs",
    "check:meter-wire": "bash scripts/check-meter-wire-parity.sh",
    "check:pe-archive-wire": "bash scripts/check-pe-archive-wire-parity.sh",
    "check:pe-export-wire": "bash scripts/check-pe-export-wire-parity.sh",
    "check:wp2": "node scripts/wp2/generate-pvt9-base-config.mjs --check --audit --self-test && npm run check:mutation-registry && npm run check:workflows && npm run check:repo-boundary && npm run check:reader-ids && npm run check:review-open",
    "check:workflows": "node scripts/check-workflow-budget.mjs --self-test",
    "check:review-open": "node provian-website/scripts/review-open.mjs --self-test",
    "schema:check": "cd provian-backend && npx tsx scripts/generate-pe-schema.ts --check",
    "schema:generate": "cd provian-backend && npx tsx scripts/generate-pe-schema.ts",
    "constitution:check": "node scripts/generate-network-constitution.mjs --check",
    "constitution:generate": "node scripts/generate-network-constitution.mjs",
    "typecheck": "npm run check:wp2 && npm run money-path && npm run check:meter-wire && npm run check:pe-archive-wire && npm run check:pe-export-wire && npm run schema:check && npm run constitution:check && npm run narrative:check && tsc --noEmit",
    "build:dev": "eas build --profile development --platform ios",
    "build:dev-device": "eas build --profile development-device --platform ios",
    "build:preview": "eas build --profile preview --platform all",
    "build:production": "eas build --profile production --platform all",
    "build:run:ios": "eas build:run --platform ios",
    "build:run:android": "eas build:run --platform android",
    "build:android-apk": "eas build --profile android-apk --platform android",
    "build:android-preview": "eas build --profile preview-android --platform android",
    "check:mutation-registry": "node scripts/wp-mutation-harness.mjs --verify-registry",
    "money-path": "node scripts/money-path-tripwire.mjs",
    "money-path:accept": "node scripts/money-path-tripwire.mjs --write",
    "regen:images": "node scripts/regen-vision-images.mjs",
    "check:mcp-parity": "node scripts/check-mcp-tool-parity.mjs",
    "check:armed-copy": "node scripts/check-armed-state-copy.mjs --self-test && node scripts/check-armed-state-copy.mjs",
    "check:earning-copy": "node scripts/check-earning-copy.mjs",
    "check:reader-ids": "node scripts/check-reader-facing-ids.mjs --self-test",
    "check:manual": "node scripts/generate-manual-policy.mjs --check",
    "check:legal-app": "node scripts/generate-legal-app-content.mjs --check",
    "check:oss-notices": "node scripts/generate-oss-notices.mjs --check",
    "check:help-faq": "node scripts/generate-help-faq.mjs --check",
    "generate:help-faq": "node scripts/generate-help-faq.mjs",
    "generate:oss-notices": "node scripts/generate-oss-notices.mjs",
    "refresh:oss-notices:ios": "node scripts/oss-notices/refresh-ios.mjs",
    "refresh:oss-notices:android": "node scripts/oss-notices/refresh-android.mjs",
    "check:copy": "npm run check:mcp-parity && npm run check:armed-copy && npm run check:earning-copy && npm run check:reader-ids && npm run check:legal-app && npm run check:oss-notices && npm run check:help-faq && npm run check:manual && npm run check:localization",
    "check:installed-base-compat": "(cd provian-backend && npx jest --silent src/installed-base-compat.test.ts) && (cd provian-agent-sdk && npx vitest run src/installed-base-compat.test.ts)",
    "narrative:generate": "node scripts/generate-app-narrative.mjs && node scripts/generate-pe-generation-model.mjs",
    "narrative:check": "node scripts/generate-app-narrative.mjs --check && node scripts/generate-pe-generation-model.mjs --check",
    "check:repo-boundary": "node scripts/check-repo-boundary.mjs --self-test",
    "check:sdk-typecheck": "node scripts/check-sdk-typecheck.mjs",
    "check:pvt9-runtime": "node scripts/check-pvt9-runtime.mjs",
    "check:localization": "node scripts/check-localization.mjs --self-test && node scripts/check-push-copy.mjs"
  },
  "dependencies": {
    "@coinbase/cbpay-js": "^2.4.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.15.8",
    "@react-navigation/native": "^7.1.22",
    "@react-navigation/native-stack": "^7.8.1",
    "@scure/bip32": "^2.0.1",
    "@scure/bip39": "^2.0.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@walletconnect/core": "^2.23.4",
    "@walletconnect/react-native-compat": "^2.23.4",
    "@walletconnect/sign-client": "^2.23.4",
    "@walletconnect/web3wallet": "^1.16.1",
    "assert": "^2.1.0",
    "async-mutex": "^0.5.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "cbor-x": "^1.6.4",
    "date-fns": "^4.1.0",
    "ethers": "^6.15.0",
    "expo": "54.0.33",
    "expo-application": "^7.0.7",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "^55.0.9",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-screen-capture": "~8.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.7",
    "i18next": "^25.6.3",
    "jose": "^6.1.3",
    "json-stable-stringify": "^1.3.0",
    "process": "^0.11.10",
    "react": "19.1.0",
    "react-i18next": "^16.3.5",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.20",
    "react-native-reanimated": "^4.1.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "^0.6.1",
    "uuid": "^13.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/json-stable-stringify": "^1.1.0",
    "@types/node": "^25.0.10",
    "@types/react": "~19.1.0",
    "happy-dom": "^20.9.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.18",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LongevityManiac/provian.git"
  },
  "homepage": "https://provian.ai",
  "bugs": {
    "url": "https://github.com/LongevityManiac/provian/issues"
  }
}
