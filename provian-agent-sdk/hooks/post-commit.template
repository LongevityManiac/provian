#!/bin/sh
# --- Provian PE Hook Start ---
# Generates a Provenance Envelope for every commit.
# Disable: export PROVIAN_DISABLE_HOOK=1
# Uninstall: "$HOME/.provian/bin/provian" uninstall (hosted install), or the SDK's `setup-hook --remove`

if [ "$PROVIAN_DISABLE_HOOK" = "1" ]; then
  exit 0
fi

# If the provian-observer is running AND its GitPlugin is actively watching
# THIS repo, let the observer handle the commit (prevents double-counting).
# The observer publishes the repo roots it watches to observer-git-repos. It
# runs with cwd=$HOME and typically watches nothing, so for most repos this set
# does NOT contain the repo — and the hook must fire, or the commit is dropped
# by both. Defer only when this repo's root is in the watched set.
if [ -f "$HOME/.provian/observer.pid" ]; then
  OBSERVER_PID=$(cat "$HOME/.provian/observer.pid" 2>/dev/null)
  if [ -n "$OBSERVER_PID" ] && kill -0 "$OBSERVER_PID" 2>/dev/null; then
    PROVIAN_WATCHED="$HOME/.provian/observer-git-repos"
    PROVIAN_REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
    if [ -n "$PROVIAN_REPO_ROOT" ] && [ -f "$PROVIAN_WATCHED" ] && \
       grep -qxF "$PROVIAN_REPO_ROOT" "$PROVIAN_WATCHED" 2>/dev/null; then
      exit 0
    fi
  fi
fi

# Skip rebases, amends, cherry-picks - would double-count work
if echo "$GIT_REFLOG_ACTION" | grep -qi "rebase\|amend\|cherry-pick"; then
  exit 0
fi

# The hook names only WHICH commit it witnesses — the sha, captured here
# synchronously, before the report is backgrounded, so `git commit -m a && git
# commit -m b` names a and b, never b twice. `report-pe --hook post-commit`
# reads everything else (branch, changed files/lines) from git itself, and
# records the named commit only when git shows it exists, is reachable from
# HEAD, and was committed moments ago. commit_sha is the (user, commit_sha)
# cross-witness mint-once key shared with the observer's GitPlugin and the forge
# webhook, so whichever path witnesses a commit, exactly one mints. Manual
# reporting was removed: an actor's own claim about its work is never a
# Provenance Envelope.
COMMIT_SHA=$(git rev-parse HEAD 2>/dev/null)

# Persistent local log
PROVIAN_DIR="$HOME/.provian"
HOOK_LOG="$PROVIAN_DIR/hook.log"
mkdir -p "$PROVIAN_DIR"

# Report PE asynchronously - never blocks commits
if [ -n "$COMMIT_SHA" ]; then
  ({{REPORT_PE_CMD}} --hook post-commit --commit-sha "$COMMIT_SHA" >>"$HOOK_LOG" 2>&1 &)
fi

# Composition (WS3): chain to the repo's OWN .git/hooks/post-commit that a global
# core.hooksPath diverted git away from — but ONLY when this hook is running as
# the GLOBAL Provian hook (~/.provian/hooks). When Provian was appended INTO a
# repo's own hooksPath (Husky / lefthook / .githooks), git already ran that path's
# other content, so chaining here would DOUBLE-run it. Never run a post-commit that
# carries our marker (no self- or mutual-recursion), and a chained hook's failure
# never fails the commit (post-commit is advisory).
PROVIAN_HOOK_DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd)
if [ "$PROVIAN_HOOK_DIR" = "$HOME/.provian/hooks" ]; then
  PROVIAN_REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
  PROVIAN_DEFAULT_HOOK="$PROVIAN_REPO_ROOT/.git/hooks/post-commit"
  if [ -n "$PROVIAN_REPO_ROOT" ] && [ -x "$PROVIAN_DEFAULT_HOOK" ] && \
     ! grep -q "Provian PE Hook Start" "$PROVIAN_DEFAULT_HOOK" 2>/dev/null; then
    "$PROVIAN_DEFAULT_HOOK" || true
  fi
fi
# --- Provian PE Hook End ---
