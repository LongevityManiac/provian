# ═══════════════════════════════════════════════════════════════
#                    PROVIAN CONTRACTS .env
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git (it contains your private key)
# ═══════════════════════════════════════════════════════════════

# Deployer private key (from Phantom - WITHOUT 0x prefix)
# Phantom > Settings > Security & Privacy > Export Private Key
DEPLOYER_PRIVATE_KEY=

# Block Explorer API Keys
# One Etherscan API key works for all three explorers
# Get yours at: https://etherscan.io/myapikey
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISM_ETHERSCAN_API_KEY=

# RPC URLs (optional - defaults to public RPCs in hardhat.config.ts)
# For faster/more reliable deploys, use Alchemy:
# https://dashboard.alchemy.com/
# BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
# ARBITRUM_SEPOLIA_RPC=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY
# OPTIMISM_SEPOLIA_RPC=https://opt-sepolia.g.alchemy.com/v2/YOUR_KEY
