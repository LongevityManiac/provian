# Provian Wallet Environment Configuration
# =========================================
#
# SECURITY NOTE: API keys for blockchain services (Alchemy, Helius, TronGrid)
# are NOT stored in this file. They are managed server-side in the relay backend
# and accessed through the API proxy. See docs/PROXY_ENDPOINTS.md for details.
#
# RECOMMENDED PATTERN (2026-05-13 onward): use 1Password Secret References for
# sensitive values, run with `op run --env-file=.env -- <command>`. The .env
# file holds bare op:// URIs; the actual values resolve at process start and
# never sit on disk. See docs/SECRETS_WORKFLOW.md for the workflow.
#
# Example:
#   EXPO_PUBLIC_FIREBASE_API_KEY=op://Provian/Firebase iOS API Key/credential
#
# Or copy this file to .env and fill cleartext values (less secure; only for
# contributors without 1Password access).

# ============================================
# Firebase Configuration (CLIENT-SIDE REQUIRED)
# ============================================
# Get these values from Firebase Console > Project Settings > General > Your apps > Web app
# https://console.firebase.google.com
#
# SECURITY: These are restricted by Bundle ID (iOS) and SHA-256 fingerprint (Android).
# Configure these restrictions in Firebase Console > Project Settings > Your apps.
# See src/config/firebase.ts for detailed security documentation.

EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key-here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Optional: Analytics
# EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# WalletConnect (CLIENT-SIDE REQUIRED)
# ============================================
# Get your project ID from https://cloud.walletconnect.com
#
# SECURITY: Restricted by Bundle ID / Package Name in WalletConnect Cloud.
# Configure allowlist at: cloud.walletconnect.com > Project Settings > Allowlist
# See src/core/walletconnect/WalletConnectService.ts for detailed security documentation.

EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# ============================================
# Privy Configuration (CLIENT-SIDE REQUIRED)
# ============================================
# Get your app ID from https://privy.io

EXPO_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# ============================================
# Fee Wallet Addresses
# ============================================
# These wallets receive the transaction fee
# Generate new addresses for production use

EXPO_PUBLIC_FEE_WALLET_EVM=0x0000000000000000000000000000000000000000
EXPO_PUBLIC_FEE_WALLET_SOLANA=11111111111111111111111111111111
EXPO_PUBLIC_FEE_WALLET_TRON=T9yD14Nj9j7xAB4dbGeiX9h8unkKHxuWwb

# ============================================
# REMOVED: Blockchain API Keys
# ============================================
# These API keys are now managed server-side through the relay backend proxy.
# They should NOT be included in the client app.
#
# - EXPO_PUBLIC_ALCHEMY_API_KEY (removed - proxied via /api/proxy/alchemy)
# - EXPO_PUBLIC_HELIUS_API_KEY (removed - proxied via /api/proxy/helius)
# - EXPO_PUBLIC_TRONGRID_API_KEY (removed - proxied via /api/proxy/trongrid)
# - EXPO_PUBLIC_ONRAMPER_API_KEY (removed - proxied via /api/proxy/onramper)
#
# See docs/PROXY_ENDPOINTS.md for the proxy endpoint documentation.

# ============================================
# Contract Deployment (for deployers only)
# ============================================

# Private key for deploying contracts (without 0x prefix)
# NEVER commit the actual key - use a dedicated deployer wallet
# Fund with testnet ETH from faucets:
# - Base Sepolia: https://www.coinbase.com/faucets/base-ethereum-goerli-faucet
# - Arbitrum Sepolia: https://faucet.arbitrum.io
# - Optimism Sepolia: https://faucet.quicknode.com/optimism/sepolia
DEPLOYER_PRIVATE_KEY=

# Block explorer API keys for contract verification
# Get from: https://basescan.org/myapikey
BASESCAN_API_KEY=
# Get from: https://arbiscan.io/myapikey
ARBISCAN_API_KEY=
# Get from: https://optimistic.etherscan.io/myapikey
OPTIMISM_ETHERSCAN_API_KEY=

# ============================================
# Solana RPC (optional - falls back to public endpoint)
# ============================================
# Dedicated Helius RPC endpoint for production Solana traffic.
# Get one at https://helius.dev - avoids public RPC rate limits.
EXPO_PUBLIC_SOLANA_RPC_URL=

# Optional: Custom RPC endpoints (defaults to public endpoints)
# BASE_SEPOLIA_RPC=https://sepolia.base.org
# ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
# OPTIMISM_SEPOLIA_RPC=https://sepolia.optimism.io

# ============================================
# Feature flags
# ============================================
# Alchemy Pay-As-You-Go plan active? Controls whether the token-approval
# scan runs (uses eth_getLogs with a ~9000-block window). Free tier caps
# eth_getLogs at 10 blocks per call, which makes the feature impossible
# on free. Flip to true after upgrading your Alchemy account - the
# Dashboard banner ("Token approval monitoring off") disappears and
# approval detection runs automatically on all 4 EVM chains.
EXPO_PUBLIC_ALCHEMY_PAYG=false

