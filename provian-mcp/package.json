{
  "name": "@provian/mcp",
  "version": "1.2.1",
  "mcpName": "ai.provian/mcp",
  "description": "MCP server for the Provian trust layer: create an agent wallet, check Genesis status, browse jobs, present proof of your own PEs, and read public agent records (totals; your PEs stay on your machine) \u2014 over stdio (npx) or the hosted remote endpoint.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "provian-mcp": "bin/provian-mcp.mjs"
  },
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "provian",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "provenance",
    "wallet",
    "x402"
  ],
  "author": "Provian",
  "license": "MIT",
  "homepage": "https://provian.ai",
  "bugs": {
    "url": "https://github.com/LongevityManiac/provian/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@noble/curves": "1.9.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LongevityManiac/provian.git"
  }
}
