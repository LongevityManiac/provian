# Secrets / keys
.env
.env.*
!.env.example
.foundation-treasury-key.json
GoogleService-Info.plist
# Note: android/app/google-services.json IS committed. Per Firebase docs it is
# not sensitive; it is shipped in every APK.
# The app.json googleServicesFile sources live OUTSIDE android/ and ios/, because
# `expo prebuild --clean` deletes both native dirs before it copies them in (L326).
# scripts/check-prebuild-sources-sync.sh (run by build-android-release.sh) refuses drift.
!config/firebase/GoogleService-Info.plist

# Local print artifacts (regenerated locally; not source of truth)
PRE_LAUNCH_CHECKLIST.pdf
output/

# Native build artifacts that must NOT be committed even though android/ and
# ios/ are now tracked directories.
android/app/*.keystore
android/app/*.jks
# Launch-keystore signing config for scripts/build-android-release.sh :
# holds the keystore path + passwords for the leak-free Gradle-direct release
# build. NEVER commit it — the keystore material must stay off the command line
# AND out of version control.
android/keystore.properties
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
modules/*/android/build/
android/local.properties
ios/Pods/
ios/build/
ios/build-device/
ios/DerivedData/
ios/Provian.xcworkspace/xcuserdata/
ios/Provian.xcodeproj/xcuserdata/
ios/.xcode.env.local

