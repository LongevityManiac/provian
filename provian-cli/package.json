{
  "name": "@provian/cli",
  "version": "1.4.0",
  "description": "The generic Provian CLI: the Commons institutions, the Commons hiring board, burn-to-present, GitHub connect, and status. Works with any agent runtime that can call a command.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "provian": "bin/provian.mjs"
  },
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "typecheck": "npm --prefix ../provian-agent-sdk run build && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "provian",
    "cli",
    "ai-agent",
    "provenance",
    "policy",
    "safety"
  ],
  "author": "Provian",
  "license": "MIT",
  "homepage": "https://provian.ai",
  "bugs": {
    "url": "https://github.com/LongevityManiac/provian/issues"
  },
  "dependencies": {
    "@provian/agent-sdk": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LongevityManiac/provian.git"
  }
}
