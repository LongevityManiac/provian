# =============================================================================
# .env.deploy - Credentials for Cloud Run deployment
#
# Copy this file to .env.deploy and fill in deploy config.
# .env.deploy is git-ignored, but managed runtime secrets still do not belong
# here. deploy-env.sh maps those env vars to GCP Secret Manager secret refs.
#
# Usage:
#   cp .env.deploy.example .env.deploy
#   # fill in values
#   bash deploy-env.sh
# =============================================================================

# --- Secret Manager managed runtime secrets ---
#
# Do not put plaintext values for these in .env.deploy:
#   SCHEDULER_SECRET -> scheduler-secret
#   AGENT_BANK_ADMIN_SECRET -> agent-bank-admin-secret  (audit 2026-08-05 finding 8: gates the
#     x-admin-secret routes — dispute-resolve, /v1/admin/health, court panel-assign. REQUIRED at boot.)
#   UNSUBSCRIBE_TOKEN_SECRET -> unsubscribe-token-secret  (audit 2026-08-05 finding 17: HMAC key for
#     one-click unsubscribe tokens. FAIL-CLOSED: unset => marketing invite emails do not send — no
#     invite email goes out before a working unsubscribe. Provision + mount in the same revision as
#     the launch deploy.)
#   PVT_MINTER_KEY -> pvt-minter-key
#   TOKEN_SIGNING_SECRET -> token-signing-secret
#   SESSION_SECRET -> session-secret
#   ADMIN_API_KEY -> admin-api-key
#   RELAY_SIGNING_KEY -> relay-signing-key
#   RESEND_API_KEY -> resend-api-key
#
# 1Password is the human-controlled source; GCP Secret Manager is the Cloud Run
# runtime source. deploy-env.sh validates the GCP secrets exist and applies
# --update-secrets for these names.

# --- iOS App Attest (required) ---

IOS_BUNDLE_ID=com.provian.wallet
IOS_TEAM_IDENTIFIER=L83XFY5S26

# --- Chain RPC endpoints (required) ---

BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
# Second, independent operator per chain. The chain-record lane re-reads every transaction
# through both legs, which must agree; the Arbitrum One / OP Mainnet scan reads transfers through
# the Alchemy leg, so one of the two must be Alchemy.
ARBITRUM_RPC_URL_SECONDARY=
OPTIMISM_RPC_URL_SECONDARY=
# Solana chain-record lane: two endpoints of different operators (e.g. Alchemy and
# api.mainnet-beta.solana.com). Without both, the Solana lane does not run.
SOLANA_RPC_URL=
SOLANA_RPC_URL_SECONDARY=

# --- Email via Resend ---
#
# RESEND_API_KEY is Secret Manager managed as resend-api-key.
RESEND_SENDER_EMAIL=noreply@provian.ai
#  Phase 4: public site base used to build the submitter activation-notice
# link (provian.ai/proposals/<type>). Optional; defaults to https://provian.ai.
PROVIAN_PUBLIC_SITE_URL=
# ON in production  and stays on, so the pending-policy queue always
# has a resolve path. Classify writes record_only only; no admin write makes a row mint.
PVT_POLICY_CLASSIFICATION_WRITES_ENABLED=true

# --- Contract addresses (warned if missing, features disabled) ---
#
# The public-launch boot guard reads NO kernel address from env: its mint-path seam
# (genesis-launch-guard.ts, resolveMintPathPresence) is the pinned config/pvt9-base.json
# kernel. Setting PVT_CONTRACT_ADDRESS does not satisfy, and cannot break, that guard.
PVT_CONTRACT_ADDRESS=
GOVERNANCE_CONTRACT_ADDRESS=
PE_ANCHOR_CONTRACT_ADDRESS=
ESCROW_CONTRACT_ADDRESS=
PROMISE_CONTRACT_ADDRESS=
POOL_CONTRACT_ADDRESS=
COURT_CONTRACT_ADDRESS=

# --- Redis / Upstash (REST API) ---
#
# Required for caching and for security-critical rate limiters. When absent,
# /v1/users/recover fails closed (503 on every attempt), so this is not
# optional in production. The REST pair is distinct from the rediss://
# protocol URL: get both from the Upstash console -> database -> REST API.
#
# UPSTASH_REDIS_REST_TOKEN is Secret Manager managed as upstash-redis-rest-token
# (do not put its value here; the deploy refuses plaintext managed secrets).
UPSTASH_REDIS_REST_URL=

# --- Firestore database ---
#
# Which Firestore database the relay reads and writes (src/firestore-db.ts
# relayDb()). Unset/empty = "(default)". A named id must be 4-63 chars of
# [a-z0-9-], start with a letter and end with a letter or digit; an invalid
# value refuses to boot (fail closed, never a silent fallback to "(default)").
# deploy-env.sh also syncs indexes / field overrides / TTLs into this database
# (deploy-firestore-indexes.js), and operator scripts follow it
# (scripts/lib/script-db.ts).
#
# Rollback: set it back to "(default)" EXPLICITLY. Deleting the line does not
# unset it on Cloud Run, because the deploy merges env vars (--update-env-vars).
FIRESTORE_DATABASE_ID=

# --- Scheduler OIDC audience ---
#
# Cloud Scheduler mints its OIDC token with the run.app service URL as the
# audience, not the custom domain. List both (comma-separated) so OIDC verifies
# instead of falling back to the shared secret.
CLOUD_RUN_SERVICE_URL=https://api.provian.ai,https://provian-api-185909722463.us-central1.run.app

# =============================================================================
# PVT9 SETTLEMENT (M7)
# =============================================================================
# Arms the settlement route. It must be EXACTLY this string — no default, no
# boolean coercion, no truthy value that could arrive from a template.
#
# Arming alone does not settle anything. POST /v1/internal/settlement/pvt9-run
# also requires admin auth AND the same token echoed in the request body, and it
# is mounted on no scheduler. The epoch keeper
# (POST /v1/internal/scheduler/pvt9-epoch-keeper) is scheduled and is NOT gated
# on this: openNextEpoch() carries no modifier, mints nothing, and moves nothing.
# Standard runs daily; each payee is due N UTC calendar days after its own last settlement.
PVT9_STANDARD_SETTLEMENT_INTERVAL_DAYS=30
# First per-batch deployment sets this to its UTC cutover time for operator summary coverage.
METER_BATCH_SUMMARY_START_MS=
PVT9_SETTLEMENT_ARMED=

# The two settlement signers arrive as Secret Manager mounts and MUST stay empty
# here (deploy-env.sh refuses a plaintext value):
#   PVT9_SETTLEMENT_MINTER_KEY   -> secret `pvt-minter-key`
#   PVT9_SETTLEMENT_APPROVER_KEY -> secret `pvt9-batch-approver-key`

# =============================================================================
# PUBLIC-LAUNCH FLIP CEREMONY (the flip is the operator’s act — keep false until then)
# =============================================================================
# The relay REFUSES to boot with PUBLIC_LAUNCH=true unless BOTH mint-readiness
# conjuncts hold (genesis-launch-guard.ts;  + audit 2026-08-05):
#   1. PVT_MINTING_DELIBERATELY_ENABLED is EXACTLY the string 'true' — absent,
#      'false', '', or any other value refuses under its own named verdict; AND
#   2. the pinned config/pvt9-base.json records a deployed, non-forbidden PVT9 kernel
#      (read from the config, never from env — nothing to set here).
# The boot error NAMES every failing conjunct so a half-configured flip is legible.
#
# At the flip, PUBLIC_LAUNCH=true and PVT_MINTING_DELIBERATELY_ENABLED=true are added
# to .env.deploy (so a later deploy-env.sh cannot revert them) and applied to Cloud Run
# in one update. See FLIP_RUNBOOK.md §4.2 (internal records).
PVT_MINTING_DELIBERATELY_ENABLED=false

# Hosted MCP surface (POST /mcp, /.well-known/mcp.json): CLOSED until launch (, the operator
# 2026-10-22). Agents onboard through an invite code and the curl | sh line (/v1/bootstrap/*),
# never /mcp. Keep an explicit false: deploy-env.sh merges env vars additively, so deleting the
# line would leave a previous Cloud Run value live. PUBLIC_LAUNCH=true opens /mcp at the flip.
MCP_AGENT_ONBOARDING=false

# =============================================================================
# FORGE WITNESS (Witness 3) — non-secret slug
# =============================================================================
# GITHUB_APP_SLUG is the public slug of the registered GitHub App
# (github.com/apps/<slug>); it drives the connect-flow install URL only — the
# webhook receiver itself needs only GITHUB_APP_WEBHOOK_SECRET. Not sensitive.
# The app-wide webhook secrets (GITHUB_APP_WEBHOOK_SECRET / GITLAB_WEBHOOK_SECRET
# / BITBUCKET_WEBHOOK_SECRET) are Secret Manager bolt-ons mounted via
# --update-secrets, NOT set here.
GITHUB_APP_SLUG=provian-git-witness
GITHUB_APP_ID=4570525
GITHUB_PR_GATE_ENABLED=true
# GITHUB_APP_PRIVATE_KEY is mounted from Secret Manager as github-app-private-key.
# Installation tokens are restricted to one of Provian's two gated repositories.

# Trust Layer §2.9 : the App Attest App ID (TeamID.bundleId) the relay verifies rpIdHash against.
APPLE_APP_ATTEST_APP_ID=L83XFY5S26.com.provian.wallet

# ── : Provian's x402 facilitator (its own Cloud Run service) ──
# The shared secret it presents on POST /v1/internal/x402/facilitator-settlement is the managed
# secret FACILITATOR_RELAY_SECRET (Secret Manager `facilitator-relay-secret`, via --update-secrets;
# NOT set here). Unset (or under 32 characters) → that route answers 503.
# The deployed ProvianX402FeeSettler (Base). REQUIRED for Base settlements to be witnessed;
# unset → every Base report answers 503 and the outbound USDC watcher relabels nothing.
# FACILITATOR_SETTLER_ADDRESS=0x...
# The facilitator's gas wallets, by ADDRESS ONLY (the relay never holds their keys). Default to the
# published addresses when unset; the Base one is also the fee recipient the relay checks for.
# FACILITATOR_BASE_GAS_ADDRESS=0xA37fC594E98e951571C771C9e77CDC73f67d3efB
# FACILITATOR_SOLANA_GAS_ADDRESS=DPB89TipwTCxFnQCdtvJE8cm8718jytvzyYEBfQP3t2
# FACILITATOR_SOLANA_FEE_WALLET=DPB89TipwTCxFnQCdtvJE8cm8718jytvzyYEBfQP3t2
# Solana RPC for the relay's own re-read (optional; default Alchemy via ALCHEMY_API_KEY, else public).
# FACILITATOR_SOLANA_RPC_URL=

# Paid Base providers support 500-block windows; independent verification and adaptive splits remain.
INBOUND_USDC_BLOCK_CHUNK=500
OUTBOUND_USDC_BLOCK_CHUNK=500
INSTITUTION_WATCHER_BLOCK_CHUNK=500

# In-app purchase receipt verification (store builds). The key and issuer IDs are plain config; the
# private keys are Secret Manager secrets (app-store-connect-private-key,
# google-play-service-account-json), never values here. STORE_ACCEPT_SANDBOX=true credits purchases
# the store itself marks as sandbox / license test (App Review and testers); unset refuses them.
# APP_STORE_CONNECT_ISSUER_ID=
# APP_STORE_CONNECT_KEY_ID=
# STORE_ACCEPT_SANDBOX=

# Chain observation drain: bounded transaction-driven workers; empty queues return immediately.
# Increase concurrency for higher transaction rates after sizing provider/Firestore capacity.
CHAIN_RECORD_DRAIN_CONCURRENCY=16
CHAIN_RECORD_DRAIN_BUDGET_MS=240000

# BASE_RPC_URL_SECONDARY and BASE_TRACE_RPC_URL_SECONDARY are mounted from
# Secret Manager base-rpc-url-secondary; never put their credentials in this file.
# BASE_DISCOVERY_RPC_OPERATOR_ID selects which verified operator discovers pointers.
# Set it to drpc for flat per-request discovery billing; both operators still verify facts.
BASE_DISCOVERY_RPC_OPERATOR_ID=drpc
