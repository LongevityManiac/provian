# =============================================================================
# Provian Backend - Environment Variables
# =============================================================================
# Copy to .env and fill in secrets. Contract addresses are public (on-chain).
# NEVER commit .env with real secret values.
#
# Hand-maintained template for a local relay; no generator writes it, and it is
# not an exhaustive list of every variable the relay reads. Deploy config lives in
# .env.deploy (template: .env.deploy.example), read by deploy-env.sh.
# Source of truth for Base contract addresses:
# contracts/deployments/base-pvt9-institutions.json (tabled in docs/CHAIN_STATUS.md).
# =============================================================================

# -----------------------------------------------------------------------------
# Hard-required secrets - server refuses to start without these.
# Local dev should use 1Password Secret References with:
#   op run --env-file=.env -- npm run dev
# Production Cloud Run receives these from GCP Secret Manager via secretKeyRef.
# -----------------------------------------------------------------------------
TOKEN_SIGNING_SECRET=op://Provian/p2l5b3jdnwr3oofpxye42bvh4u/credential  # REQUIRED - HMAC token signing
SESSION_SECRET=op://Provian/q2f3oot32llaw2wgyvo5h6hfqe/credential        # REQUIRED - Passkey session HMAC signing
SCHEDULER_SECRET=op://Provian/Cloud Run SCHEDULER_SECRET/credential       # REQUIRED - Auth for /v1/internal/scheduler/* endpoints
RELAY_SIGNING_KEY=op://Provian/v7zmetdmesn6yljaqrmas4jej4/credential      # REQUIRED - Conformance badge HMAC signing
AGENT_BANK_ADMIN_SECRET=       # REQUIRED - x-admin-secret routes (escrow dispute-resolve, court panel-assign, pool and contract-registry admin); also the fallback for ADMIN_API_KEY routes

# -----------------------------------------------------------------------------
# Optional secrets / admin keys
# -----------------------------------------------------------------------------
REGISTRY_SIGNING_SECRET=       # Optional - Pre-verification registry signing
ADMIN_API_KEY=op://Provian/2ipppqpnsbjuf6uxn3nikubaeq/credential          # Operator/admin routes (admin health, Genesis / PVT-policy admin, PVT9 operations, burn-floor operations); falls back to AGENT_BANK_ADMIN_SECRET
# PE-anchor signer: signs the daily (and operator-run segment) PE-anchor transactions
# (core/pvt/pe-anchor-runtime.ts). Production mounts the same Secret Manager secret
# (pvt-minter-key) as PVT9_SETTLEMENT_MINTER_KEY (deploy-env.sh). Not boot-required;
# without it the anchor signer is unconfigured. Do not paste plaintext into .env.
PVT_MINTER_KEY=

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=op://Provian/ith5pmjs5lciw4ydkuidhb3g4a/credential # Required for transactional email
RESEND_SENDER_EMAIL=noreply@provian.ai  # Must be from a verified domain in Resend
# Operator switch for classify/reject on the pending-policy queue. Production runs it ON
#; local default off, so classify/reject writes return 503.
PVT_POLICY_CLASSIFICATION_WRITES_ENABLED=false

# -----------------------------------------------------------------------------
# API proxy keys (Cloud Run only - never embed in mobile)
# -----------------------------------------------------------------------------
ALCHEMY_API_KEY=
ZEROX_API_KEY=
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISM_ETHERSCAN_API_KEY=
COINGECKO_API_KEY=             # Optional - CoinGecko demo key for the wallet price feed (GET /api/proxy/prices)
# ONRAMPER_API_KEY removed (P4-14): Onramper retired as a fiat on-ramp;
# Coinbase Onramp (COINBASE_CDP_* below) is the sole live path.

# Coinbase Onramp secure initialization (session token).
# Create a CDP *Secret* API Key (Ed25519) at https://portal.cdp.coinbase.com
# (NOT a Client API Key). COINBASE_CDP_API_PRIVATE_KEY is a secret -> store in
# Secret Manager, not plaintext. If unset, /api/proxy/coinbase/session-token
# returns 503 and the in-app Coinbase buy flow is disabled.
COINBASE_CDP_API_KEY_ID=
COINBASE_CDP_API_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# RPC URLs (REQUIRED - the server refuses to start without the three primaries;
# there is no silent public-RPC fallback)
# -----------------------------------------------------------------------------
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io

# -----------------------------------------------------------------------------
# Smart contract addresses (public, on-chain).
#
# Base: the  successor set bound to the live PVT9 kernel
# (contracts/deployments/base-pvt9-institutions.json, which carries the retired
#  set under `predecessor`). The PVT9 kernel address and ABI the relay uses
# come from config/pvt9-base.json, not env. Arbitrum/Optimism: legacy-chain
# addresses.
#
# Single-valued vars below = Base default (legacy single-chain shape).
# Wave J-bis per-chain variants (`<NAME>_CONTRACT_ADDRESS_BASE` /
# `_ARBITRUM` / `_OPTIMISM`) take precedence when set. While
# ENABLE_PVT_PRINCIPAL=true the PVT-principal Escrow/Promise/Pool resolvers use
# the addresses pinned in core/agent-bank/pvt-principal-config.ts (the  Escrow/Promise
# and the 2026-10-20 PoolV3) over env.
# The full registry history is reference/CONTRACT_VERSION_STATUS.md (internal records).
# -----------------------------------------------------------------------------

# No PVT kernel address is read from env. The public-launch boot guard
# (core/pvt/genesis-launch-guard.ts) reads the kernel from config/pvt9-base.json;
# with PUBLIC_LAUNCH=true the relay boots only when PVT_MINTING_DELIBERATELY_ENABLED=true
# and that pinned config records a deployed kernel.

# PEAnchor (Base; the daily meter anchor)
PE_ANCHOR_CONTRACT_ADDRESS=0x889A59A847e490c5Cc91f281468AbAacc100a9fD

# Agent Bank - EscrowV4 (Base =  successor, admin 0xCa37a15A nonce 27; Arb/Op Chunk II)
ESCROW_CONTRACT_ADDRESS=0x96560fDF49e563eFCdc2d502934676DC074732d0
ESCROW_CONTRACT_ADDRESS_BASE=0x96560fDF49e563eFCdc2d502934676DC074732d0
ESCROW_CONTRACT_ADDRESS_ARBITRUM=0x73934580ecFD8Bf1F689f73205A2E681fEAa54AF
ESCROW_CONTRACT_ADDRESS_OPTIMISM=0x73934580ecFD8Bf1F689f73205A2E681fEAa54AF

# Agent Bank - PromiseV3 (Base =  successor, nonce 28; Arb/Op Chunk II)
PROMISE_CONTRACT_ADDRESS=0x7506F4A052750260A0ddcdF5E63a77CC646d89B9
PROMISE_CONTRACT_ADDRESS_BASE=0x7506F4A052750260A0ddcdF5E63a77CC646d89B9
PROMISE_CONTRACT_ADDRESS_ARBITRUM=0x539Ae0e36fBb1a63F4B5a5167425Ff6ddbB0a369
PROMISE_CONTRACT_ADDRESS_OPTIMISM=0x539Ae0e36fBb1a63F4B5a5167425Ff6ddbB0a369

# Agent Bank - PoolV3 (Base = the 2026-10-20 shutdown-coverage PoolV3, deployed by the
# gas-only pool keeper 0xE80c010e…, nonce 0; it replaced the  pool 0xb355C79a…)
POOL_CONTRACT_ADDRESS=0x1301BF63Cb6BaE7171f6c7D895C762B243964d26
POOL_CONTRACT_ADDRESS_BASE=0x1301BF63Cb6BaE7171f6c7D895C762B243964d26
POOL_CONTRACT_ADDRESS_ARBITRUM=0x878F9e6E60e75fCBb9650c98aCffaF2890014C1d
POOL_CONTRACT_ADDRESS_OPTIMISM=0x878F9e6E60e75fCBb9650c98aCffaF2890014C1d

# Court (CourtV2; Base =  successor, nonce 31; Arb/Op unchanged)
COURT_CONTRACT_ADDRESS=0x9a326D1ff5EC97cE466CF6fc71BA6f5372E41D7f
COURT_CONTRACT_ADDRESS_BASE=0x9a326D1ff5EC97cE466CF6fc71BA6f5372E41D7f
COURT_CONTRACT_ADDRESS_ARBITRUM=0x8D53c2B5b29266b8070163742Bb09efA3fcB42A0
COURT_CONTRACT_ADDRESS_OPTIMISM=0x8D53c2B5b29266b8070163742Bb09efA3fcB42A0

# BondPool (performance bonds; Base =  successor, nonce 30; Arb/Op unchanged)
BOND_POOL_CONTRACT_ADDRESS=0x6b09E9C72316De9d62d63f09B187d4c86bBf787E
BOND_POOL_CONTRACT_ADDRESS_BASE=0x6b09E9C72316De9d62d63f09B187d4c86bBf787E
BOND_POOL_CONTRACT_ADDRESS_ARBITRUM=0x55A1e082cFf86c83b2147202ed86E952be3f2243
BOND_POOL_CONTRACT_ADDRESS_OPTIMISM=0x55A1e082cFf86c83b2147202ed86E952be3f2243

# -----------------------------------------------------------------------------
# Foundation Membership — inert: the membership seam is always disabled and
# ignores these (core/foundation-membership/client.ts). Recorded for reference.
# -----------------------------------------------------------------------------
FOUNDATION_MEMBERSHIP_ADDRESS_BASE=0xBf471fb8778e0c474a1a79f5804b7057174492b8
FOUNDATION_MEMBERSHIP_ADDRESS_ARBITRUM=0x8625089A92Bd4261a810e9793d1F6AE56e684F98
FOUNDATION_MEMBERSHIP_ADDRESS_OPTIMISM=0x8625089A92Bd4261a810e9793d1F6AE56e684F98

# -----------------------------------------------------------------------------
# Feature flags
#
# ENABLE_POOLS: anything but `true` answers the pool routes 503 coming_soon
# (requireFeature in routes/agent-pools.ts). ENABLE_PVT_PRINCIPAL: PVT as principal
# in the Commons institutions (core/agent-bank/pvt-principal-config.ts).
# -----------------------------------------------------------------------------
ENABLE_POOLS=true
ENABLE_PVT_PRINCIPAL=false

# -----------------------------------------------------------------------------
# Value destinations vs key identities — READ BEFORE EDITING EITHER
# -----------------------------------------------------------------------------
# These two look interchangeable and are NOT. Conflating them is exactly the
#  defect: one variable served both roles, so every reader saw a value
# that looked right for its own purpose while agent swap fees routed to a
# key-exposed EOA.
#
# SWAP_FEE_RECIPIENT — a DESTINATION. Receives the 0x Swap v2 integrator fee
# (25 bps, on the buy token) for agent swap quotes. Production value is the
# Provian treasury. Guarded at boot and again at request time by
# src/core/config/live-value-recipients.ts, which refuses any exposed-key
# address here. Leave blank to close agent swap quoting entirely (the route
# 500s before quoting).
SWAP_FEE_RECIPIENT=0x086e0F377af1245B8888540f39e99A42a7daF1dA
#
# KEEPER_FORBIDDEN_SIGNER_ADDRESS — a KEY IDENTITY, not a destination: an address no
# keeper key may resolve to. Formerly PROVIAN_TREASURY_ADDRESS; the relay still reads
# the former name (and forbids both when both are set) while the deployed environment
# carries it. Its only backend consumers are the three keeper guards
# (escrow-release.ts, pool-keeper.ts, bond-keeper.ts), which put it in a FORBIDDEN set
# so a keeper key can never also be a privileged key.
#
# SET IT TO THE TREASURY (corrects  here). Both addresses that must be
# excluded — the exposed legacy EOA and the treasury — are now pinned in
# core/config/live-value-recipients.ts::FORBIDDEN_KEEPER_IDENTITIES and covered
# unconditionally. One variable cannot name two addresses, so before  the
# treasury (which receives EVERY fee in the system and is now SWAP_FEE_RECIPIENT)
# sat in no forbidden set at all: ESCROW_RELEASE_KEY / POOL_KEEPER_KEY /
# BOND_KEEPER_KEY could have been set to the treasury key and every guard passed.
# Pointing this variable at the treasury adds a redundant second layer; it removes
# nothing, because the exposed EOA no longer depends on it. This RESTORES institution deployment
# post-broadcast checklist step 4 —  wrongly claimed it inverted it.
KEEPER_FORBIDDEN_SIGNER_ADDRESS=0x086e0F377af1245B8888540f39e99A42a7daF1dA
#
# Scope: this is THE RELAY'S env only. Historical contract deploy scripts read
# PROVIAN_TREASURY_ADDRESS as an immutable constructor DESTINATION (feeWallet /
# provianTreasury); in any contracts/.env that name still means the address that
# RECEIVES fees. scripts/wp13/deploy-institutions.mjs does not read either name.
KEEPER_FORBIDDEN_SIGNER_ADDRESS_SCOPE_NOTE=relay-env-only

# -----------------------------------------------------------------------------
# Court / anchor-recovery config
# -----------------------------------------------------------------------------
COURT_MIN_ARBITRATORS=15            # Minimum panelists for court panel selection
ANCHOR_RECOVERY_ETH_USD_PRICE=      # Optional cost guardrail for anchor-recovery worker

# -----------------------------------------------------------------------------
# Infrastructure
# -----------------------------------------------------------------------------
PORT=8080
NODE_ENV=production
GCP_PROJECT_ID=provian-ai           # Primary; falls back to GOOGLE_CLOUD_PROJECT
CLOUD_RUN_SERVICE_URL=https://api.provian.ai
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Relay URLs
# -----------------------------------------------------------------------------
API_BASE_URL=                       # Optional - relay base URL override (openapi, ecosystem, provenance links)
RELAY_URL=                          # Optional - relay URL in emitted setup commands and Commons links (default https://api.provian.ai)

# -----------------------------------------------------------------------------
# Mobile attestation audiences (consumed by relay when verifying device tokens)
# -----------------------------------------------------------------------------
DEVICE_SIGNATURE_AUDIENCE=
IOS_BUNDLE_ID=com.provian.wallet
IOS_TEAM_IDENTIFIER=L83XFY5S26 # Required for iOS App Attest
ANDROID_PLAY_INTEGRITY_AUDIENCE=
