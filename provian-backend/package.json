{
  "name": "@provian/backend",
  "version": "1.0.0",
  "description": "Provian Cloud Run API - Authorization, push notifications, multi-device sync",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node scripts/write-scheduler-source-paths.mjs",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn src/server.ts",
    "test": "jest",
    "check:forbidden-constructs": "jest src/core/decisions/forbidden-constructs --silent",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint src --ext .ts",
    "anchor-recovery": "ts-node src/core/pvt/anchor-recovery-cli.ts",
    "verify-roles": "tsx scripts/verify-onchain-roles.ts",
    "verify-secrets": "bash scripts/verify-secret-wiring.sh",
    "check-push-dispatcher": "bash scripts/check-no-direct-multicast.sh",
    "check-unanchored": "tsx scripts/check-unanchored-batches.ts",
    "generate:pvt-policy-matrix": "tsx scripts/generate-pvt-policy-matrix.ts",
    "check:pvt-policy-matrix": "tsx scripts/generate-pvt-policy-matrix.ts --check",
    "generate:pvt-capacity-model": "tsx scripts/generate-pvt-capacity-model.ts",
    "check:pvt-capacity-model": "tsx scripts/generate-pvt-capacity-model.ts --check",
    "verify:pvt-genesis-load": "tsx scripts/verify-pvt-genesis-load.ts",
    "audit:pvt-genesis-continuity": "tsx scripts/audit-genesis-continuity.ts",
    "demote:bug-pe": "ts-node scripts/demote-bug-produced-pe.ts",
    "generate:pvt-approval-manifest": "tsx scripts/generate-pvt-approval-manifest.ts",
    "check:pvt-approval-manifest": "tsx scripts/generate-pvt-approval-manifest.ts --check",
    "reconcile:scheduler": "tsx scripts/reconcile-scheduler.ts",
    "deploy": "bash deploy-env.sh",
    "typecheck:build": "tsc --noEmit"
  },
  "keywords": [
    "provian",
    "api",
    "cloud-run",
    "authorization"
  ],
  "author": "Provian Technologies, LLC",
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@peculiar/asn1-android": "^2.7.0",
    "@peculiar/asn1-schema": "^2.7.0",
    "@peculiar/x509": "^1.14.3",
    "@upstash/redis": "^1.36.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "ethers": "^6.16.0",
    "expo-server-sdk": "^3.15.0",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.11.2",
    "firebase-admin": "^12.0.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.1.0",
    "json-stable-stringify": "^1.3.0",
    "maxmind": "^5.0.7",
    "node-app-attest": "^1.0.1",
    "resend": "^6.9.4",
    "uuid": "^9.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/json-stable-stringify": "^1.1.0",
    "@types/node": "^20.10.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@x402/extensions": "2.28.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LongevityManiac/provian.git"
  },
  "homepage": "https://provian.ai",
  "bugs": {
    "url": "https://github.com/LongevityManiac/provian/issues"
  },
  "overrides": {
    "body-parser": "1.20.9"
  }
}
